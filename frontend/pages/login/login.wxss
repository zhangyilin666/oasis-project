/* 登录页样式 */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, var(--color-primary-bg) 0%, var(--color-bg) 50%);
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.login-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-login {
  width: 100%;
  max-width: 500rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 28rpx;
  text-align: center;
  border: none;
  margin-bottom: 32rpx;
}

.btn-login:active {
  opacity: 0.85;
}

.btn-login[disabled] {
  background: #cccccc;
}

.login-notice {
  font-size: 24rpx;
  color: var(--color-text-light);
  text-align: center;
  line-height: 1.6;
}
