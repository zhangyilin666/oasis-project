<!-- 登录页 -->
<view class="login-page">
  <view class="login-header">
    <view class="logo">🌿</view>
    <text class="app-name">猫来运转</text>
    <text class="app-desc">AI 驱动的命理分析 · 传统文化生活指南</text>
  </view>

  <view class="login-section">
    <button
      class="btn-login"
      bindtap="handleLogin"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
    >
      {{isLoading ? '正在登录...' : '微信一键登录'}}
    </button>

    <text class="login-notice">
      登录即表示同意《用户协议》和《隐私政策》
    </text>
  </view>
</view>
