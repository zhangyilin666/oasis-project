# Oasis 绿洲 / 猫来运转 — 演示环境变量（npm run build:h5 --mode demo）
#
# 与 .env.production 的唯一区别就是 VITE_DEMO_MODE：
#   本文件 = true  → 全部走内置假数据，后端不可用也能完整演示 UI；
#   .env.production = false → 真实请求后端 API。
# 请勿把本文件的内容复制到 .env.production，否则线上会显示演示假数据。
VITE_DEMO_MODE=true

# 演示模式不依赖后端，留空即可（H5 同源相对路径，同生产策略）。
VITE_API_BASE_URL=
