/* 报告列表样式 */
.reports-page {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

.report-item {
  margin-top: 16rpx;
}

.report-item:first-child {
  margin-top: 20rpx;
}

.report-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.report-info {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
}

.report-arrow {
  font-size: 28rpx;
  color: var(--color-text-light);
}

.report-preview {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.report-date {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
}

.no-more {
  color: var(--color-text-light);
}
