/* 报告详情样式 */
.detail-page {
  padding-bottom: 60rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

/* 基本信息 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.info-item {
  flex: 1;
  min-width: 180rpx;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text);
}

/* 八字排盘 */
.full-bazi {
  display: block;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 8rpx;
  margin-bottom: 28rpx;
  padding: 20rpx;
  background: var(--color-primary-bg);
  border-radius: 12rpx;
}

/* 四柱表格 */
.pillar-table {
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.pillar-header, .pillar-row {
  display: flex;
}

.pillar-th, .pillar-td {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  border-right: 1rpx solid var(--color-divider);
}

.pillar-th, .pillar-td:last-child, .pillar-th:last-child {
  border-right: none;
}

.pillar-header {
  background: var(--color-primary-bg);
}

.pillar-th {
  font-weight: 600;
  color: var(--color-primary);
  font-size: 24rpx;
}

.pillar-th:first-child, .pillar-td.label {
  flex: 0.7;
  font-weight: 500;
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

.pillar-row {
  border-top: 1rpx solid var(--color-divider);
}

/* 十二宫 */
.palace-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.palace-item {
  flex: 1;
  min-width: 180rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.palace-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-bottom: 8rpx;
}

.palace-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* AI 分析 */
.analysis-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 分析日志时间线 */
.timeline {
  padding-top: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
}

.timeline-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.dot-success {
  background: var(--color-success);
  box-shadow: 0 0 8rpx rgba(92, 184, 92, 0.3);
}

.dot-error {
  background: var(--color-danger);
  box-shadow: 0 0 8rpx rgba(217, 83, 79, 0.3);
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  min-height: 40rpx;
  background: var(--color-divider);
  margin: 6rpx 0;
}

.timeline-content {
  flex: 1;
  padding-bottom: 28rpx;
  min-width: 0;
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.timeline-step {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.timeline-tag {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tag-success {
  background: rgba(92, 184, 92, 0.1);
  color: var(--color-success);
}

.tag-error {
  background: rgba(217, 83, 79, 0.08);
  color: var(--color-danger);
}

.timeline-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 时间 */
.time-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-label {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.time-value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
