/* 错误重试 */
.error-retry {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.error-message {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.btn-retry {
  background: var(--color-bg);
  color: var(--color-primary);
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--color-primary);
}

.btn-retry:active {
  background: var(--color-primary-bg);
}
