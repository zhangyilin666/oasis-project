/* Oasis 全局样式 */
page {
  --color-primary: #2c5f2d;
  --color-primary-light: #4a8c4d;
  --color-primary-bg: rgba(44, 95, 45, 0.06);
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-light: #999999;
  --color-bg: #f7f5f0;
  --color-bg-card: #ffffff;
  --color-border: #e8e4db;
  --color-divider: #f0ede6;
  --color-danger: #d9534f;
  --color-success: #5cb85c;

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.6;
}

/* 通用卡片样式 */
.card {
  background: var(--color-bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx;
  text-align: center;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #cccccc;
  opacity: 0.6;
}

/* 表单 */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.form-label .required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.form-input {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--color-primary-light);
}

.form-error {
  color: var(--color-danger);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: 20rpx 0;
}

/* Tag 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-yi {
  background: rgba(92, 184, 92, 0.1);
  color: var(--color-success);
}

.tag-ji {
  background: rgba(217, 83, 79, 0.08);
  color: var(--color-danger);
}

.tag-ji-shen {
  background: rgba(44, 95, 45, 0.08);
  color: var(--color-primary);
}
