/* 分析页样式 */
.analyze-page {
  padding-bottom: 60rpx;
}

.analyze-page .card {
  margin-top: 20rpx;
}

.form-picker {
  background: var(--color-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
}

.form-picker.placeholder {
  color: var(--color-text-light);
}

.solar-toggle {
  font-size: 24rpx;
  color: var(--color-primary-light);
  margin-left: auto;
  padding: 4rpx 12rpx;
  background: var(--color-primary-bg);
  border-radius: 8rpx;
}

.submit-note {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 16rpx;
}
