# 小易 — 生产环境变量模板
# 复制此文件为 .env 并填入真实值
# cp deploy/.env.production.template python_backend/.env
# 或用于 docker-compose: cp deploy/.env.production.template .env

# ─── 基础配置 ───
APP_NAME=小易
APP_VERSION=0.1.0
DEBUG=False

# ─── 数据库 ───
# ⚠️ 务必使用强密码！生成方式: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DATABASE_URL=mysql+pymysql://oasis_user:填写MYSQL_PASSWORD@db:3306/oasis_db?charset=utf8mb4

# ─── JWT ───
# ⚠️ 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=

# ─── AI Provider (二选一) ───
AI_PROVIDER=deepseek

# DeepSeek (推荐: 便宜、中文好)
DEEPSEEK_API_KEY=sk-
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Anthropic Claude (备选)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# ─── CORS (生产必须设置！App不需要，设为 * 即可) ───
CORS_ORIGINS=*

# ─── 速率限制 ───
RATE_LIMIT_ANALYZE_PER_DAY=5
