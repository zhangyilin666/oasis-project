# Copy to the project root as .env.api and keep it private.
# Local smoke test defaults. For a no-domain APK, follow API_GUIDE.md to
# obtain a public IP certificate and use docker-compose.api-ip.yml.
SITE_ADDRESS=:80
PUBLISH_ADDRESS=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
SERVER_IP=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET_KEY=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
ALLOW_MOCK_AI=false
RATE_LIMIT_ANALYZE_PER_DAY=5
RATE_LIMIT_DIVINATION_PER_DAY=5
