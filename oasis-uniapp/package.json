{
  "name": "xiaoyi-uniapp",
  "version": "1.0.0",
  "description": "猫来运转 — AI 驱动的传统文化生活辅助平台",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "build:app:demo": "uni build -p app --mode demo"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-components": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-ui": "^1.5.6",
    "lunar-typescript": "1.8.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5010320260611001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010320260611001",
    "esbuild": "^0.20.2",
    "sass": "^1.71.1",
    "sharp": "^0.35.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vue-tsc": "^2.0.6"
  }
