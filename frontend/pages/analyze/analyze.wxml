<!-- 八字分析页 -->
<view class="analyze-page">
  <view class="card">
    <!-- 姓名 -->
    <view class="form-group">
      <view class="form-label">
        <text>姓名</text><text class="required">*</text>
      </view>
      <input
        class="form-input"
        placeholder="请输入您的姓名"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
        maxlength="50"
      />
      <text class="form-error" wx:if="{{errors.name}}">{{errors.name}}</text>
    </view>

    <!-- 出生日期 -->
    <view class="form-group">
      <view class="form-label">
        <text>{{form.is_solar_time ? '出生日期（公历）' : '出生日期（农历）'}}</text>
        <text class="required">*</text>
        <text class="solar-toggle" bindtap="onSolarToggle">
          {{form.is_solar_time ? '切换农历' : '切换公历'}}
        </text>
      </view>
      <picker mode="date" value="{{form.birth_date}}" bindchange="onDateChange" end="{{today}}">
        <view class="form-picker {{form.birth_date ? '' : 'placeholder'}}">
          {{form.birth_date || '请选择出生日期'}}
        </view>
      </picker>
      <text class="form-error" wx:if="{{errors.birth_date}}">{{errors.birth_date}}</text>
    </view>

    <!-- 出生时间 -->
    <view class="form-group">
      <view class="form-label">
        <text>出生时间</text><text class="required">*</text>
      </view>
      <picker mode="time" value="{{form.birth_time}}" bindchange="onTimeChange">
        <view class="form-picker {{form.birth_time ? '' : 'placeholder'}}">
          {{form.birth_time || '请选择出生时间'}}
        </view>
      </picker>
      <text class="form-error" wx:if="{{errors.birth_time}}">{{errors.birth_time}}</text>
    </view>

    <!-- 性别 -->
    <view class="form-group">
      <view class="form-label">
        <text>性别</text><text class="required">*</text>
      </view>
      <picker
        mode="selector"
        range="{{genders}}"
        value="{{genderIndex}}"
        bindchange="onGenderChange"
      >
        <view class="form-picker {{form.gender ? '' : 'placeholder'}}">
          {{form.gender || '请选择性别'}}
        </view>
      </picker>
      <text class="form-error" wx:if="{{errors.gender}}">{{errors.gender}}</text>
    </view>

    <!-- 出生地点 -->
    <view class="form-group">
      <view class="form-label">
        <text>出生地点</text><text class="required">*</text>
      </view>
      <input
        class="form-input"
        placeholder="例如：北京"
        value="{{form.location}}"
        data-field="location"
        bindinput="onInput"
        maxlength="100"
      />
      <text class="form-error" wx:if="{{errors.location}}">{{errors.location}}</text>
    </view>

    <!-- 提交 -->
    <button class="btn-primary" bindtap="handleSubmit">
      开始八字命理分析
    </button>

    <text class="submit-note">分析可能需要几秒钟，请耐心等待</text>
  </view>
</view>
