[Unit]
Description=猫来运转 Backend API
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/oasis/python_backend
EnvironmentFile=/opt/oasis/.env
ExecStart=/opt/oasis/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/oasis/python_backend/app/logs

[Install]
WantedBy=multi-user.target
