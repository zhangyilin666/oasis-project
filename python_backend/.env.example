APP_NAME=猫来运转
APP_VERSION=0.1.0
DEBUG=False
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/oasis_db?charset=utf8mb4
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY

# AI Provider: "deepseek" | "anthropic" | "" (空=mock)
AI_PROVIDER=deepseek

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# DeepSeek (OpenAI 兼容协议)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash

# WeChat Mini-Program
WECHAT_APPID=wx_your_appid
WECHAT_SECRET=your_wechat_secret

# SMS 短信服务（App 手机号登录）
# 生产环境: aliyun / tencent；开发环境留空或设为 mock
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=猫来运转
SMS_TEMPLATE_CODE=SMS_123456789

# CORS 允许来源（逗号分隔，* = 全部）
CORS_ORIGINS=*

# 每用户每天最大分析次数（0 = 无限制）
RATE_LIMIT_ANALYZE_PER_DAY=5

# 仅离线演示和自动化测试允许模拟 AI，正式使用保持 false。
ALLOW_MOCK_AI=false
REPORT_TIMEOUT_MINUTES=15
# 留空使用项目 data_center/knowledge。
KNOWLEDGE_DIR=
