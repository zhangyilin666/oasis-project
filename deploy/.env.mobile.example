# Copy to project root as .env.mobile; do not commit real credentials.
# For HTTPS use a domain pointing to the server; :80 is for local testing only.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET_KEY=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
ALLOW_MOCK_AI=false
RATE_LIMIT_ANALYZE_PER_DAY=5