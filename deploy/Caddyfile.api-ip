{
    # IP URLs omit TLS SNI; select the public IP certificate explicitly.
    default_sni {$SERVER_IP}
}

https://{$SERVER_IP} {
    tls /etc/letsencrypt/live/{$SERVER_IP}/fullchain.pem /etc/letsencrypt/live/{$SERVER_IP}/privkey.pem
    encode gzip
    @api path /api/* /health
    handle @api {
        reverse_proxy backend:8000
    }
    handle {
        respond "Not Found" 404
    }
}
