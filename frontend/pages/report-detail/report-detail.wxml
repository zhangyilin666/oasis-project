<!-- 报告详情页 -->
<view class="detail-page">
  <block wx:if="{{report}}">
    <!-- 基本信息 -->
    <view class="card">
      <text class="card-title">基本信息</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">出生信息</text>
          <text class="info-value">{{report.birth_info}}</text>
        </view>
        <view class="info-item" wx:if="{{report.calendar_data.animal}}">
          <text class="info-label">生肖</text>
          <text class="info-value">{{report.calendar_data.animal}}</text>
        </view>
        <view class="info-item" wx:if="{{report.calendar_data.lunar_year_cn}}">
          <text class="info-label">农历</text>
          <text class="info-value">{{report.calendar_data.lunar_year_cn}}{{report.calendar_data.lunar_month_cn}}{{report.calendar_data.lunar_day_cn}}</text>
        </view>
      </view>
    </view>

    <!-- 八字四柱 -->
    <view class="card">
      <text class="card-title">八字排盘</text>
      <text class="full-bazi">{{report.calendar_data.full_bazi}}</text>

      <!-- 四柱表格 -->
      <view class="pillar-table">
        <view class="pillar-header">
          <text class="pillar-th">四柱</text>
          <text class="pillar-th">年柱</text>
          <text class="pillar-th">月柱</text>
          <text class="pillar-th">日柱</text>
          <text class="pillar-th">时柱</text>
        </view>
        <view class="pillar-row" wx:for="{{pillarFields}}" wx:key="label">
          <text class="pillar-td label">{{item.label}}</text>
          <text class="pillar-td">{{report.calendar_data.year[item.key] || '-'}}</text>
          <text class="pillar-td">{{report.calendar_data.month[item.key] || '-'}}</text>
          <text class="pillar-td">{{report.calendar_data.day[item.key] || '-'}}</text>
          <text class="pillar-td">{{report.calendar_data.hour[item.key] || '-'}}</text>
        </view>
      </view>
    </view>

    <!-- 十二宫 -->
    <view class="card" wx:if="{{report.calendar_data.ming_gong || report.calendar_data.shen_gong || report.calendar_data.tai_yuan}}">
      <text class="card-title">十二宫</text>
      <view class="palace-grid">
        <view class="palace-item" wx:if="{{report.calendar_data.ming_gong}}">
          <text class="palace-label">命宫</text>
          <text class="palace-value">{{report.calendar_data.ming_gong}}</text>
        </view>
        <view class="palace-item" wx:if="{{report.calendar_data.shen_gong}}">
          <text class="palace-label">身宫</text>
          <text class="palace-value">{{report.calendar_data.shen_gong}}</text>
        </view>
        <view class="palace-item" wx:if="{{report.calendar_data.tai_yuan}}">
          <text class="palace-label">胎元</text>
          <text class="palace-value">{{report.calendar_data.tai_yuan}}</text>
        </view>
      </view>
    </view>

    <!-- AI 分析 -->
    <view class="card">
      <text class="card-title">AI 命理分析</text>
      <view class="analysis-text">
        <text>{{report.ai_analysis}}</text>
      </view>
    </view>

    <!-- 分析日志时间线 -->
    <view class="card" wx:if="{{report.analysis_logs && report.analysis_logs.length > 0}}">
      <text class="card-title">分析日志（共 {{report.analysis_logs.length}} 步）</text>

      <view class="timeline">
        <view
          class="timeline-item"
          wx:for="{{report.analysis_logs}}"
          wx:key="_key"
        >
          <!-- 节点圆点 + 连线 -->
          <view class="timeline-indicator">
            <view class="timeline-dot {{item._statusClass}}"></view>
            <!-- index 是 WXML 内置变量，指向当前循环下标 -->
            <view class="timeline-line" wx:if="{{index < report.analysis_logs.length - 1}}"></view>
          </view>

          <!-- 内容 -->
          <view class="timeline-content">
            <view class="timeline-header">
              <text class="timeline-step">{{item.model_name}}</text>
              <text class="timeline-tag {{item._tagClass}}">{{item._statusText}}</text>
            </view>

            <view class="timeline-meta">
              <text class="meta-item" wx:if="{{item.latency_ms}}">
                ⏱ {{item._latencyDisplay}}
              </text>
              <text class="meta-item" wx:if="{{item.total_tokens}}">
                🔤 {{item._tokenDisplay}}
              </text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 时间 -->
    <view class="card">
      <view class="time-info">
        <text class="time-label">分析时间</text>
        <text class="time-value">{{report.created_at}}</text>
      </view>
    </view>
  </block>

  <!-- 加载中 -->
  <loading-overlay wx:if="{{isLoading}}" text="正在加载报告..." />

  <!-- 错误状态 -->
  <error-retry wx:if="{{isError && !isLoading}}" bindretry="onRetry" />
</view>
